{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhotoCurate",
  "version": "0.1.0",
  "identifier": "com.photocurate",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PhotoCurate",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Photography",
    "resources": {
      "PrivacyInfo.xcprivacy": "./"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "14.0",
      "bundleVersion": "0.1.2",
      "signingIdentity": "${APPLE_SIGNING_IDENTITY}",
      "providerShortName": "${APPLE_PROVIDER_SHORT_NAME}",
      "entitlements": "./Entitlements.plist"
    }
  }
}
