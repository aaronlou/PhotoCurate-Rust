{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhotoCurate",
  "version": "0.1.7",
  "identifier": "com.photocurate",
  "build": {
    "beforeDevCommand": "bash scripts/vite-dev.sh",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PhotoCurate",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Photography",
    "resources": {
      "PrivacyInfo.xcprivacy": "./"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "14.0",
      "bundleVersion": "0.1.7",
      "signingIdentity": "${APPLE_SIGNING_IDENTITY}",
      "providerShortName": "${APPLE_PROVIDER_SHORT_NAME}",
      "entitlements": "./Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3MzE0RTNBNzY4MUQzQ0UKUldUTzA0RjJPazR4eDlsTlgzNnBqODNjUDhPZVovY0VoL3ZrNVZ1N3FFeklrSENJNnNkMHRzQjUK",
      "endpoints": [
        "https://github.com/aaronlou/PhotoCurate-Rust/releases/latest/download/latest.json"
      ]
    }
  }
}
